{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NPC Harness Job v1",
  "type": "object",
  "required": ["schemaVersion", "jobId", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "type": "number" },
        "g": { "type": "number" },
        "b": { "type": "number" },
        "a": { "type": "number" }
      },
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/writeScript" },
        { "$ref": "#/$defs/ensureScene" },
        { "$ref": "#/$defs/ensureGameObject" },
        { "$ref": "#/$defs/setTransform" },
        { "$ref": "#/$defs/ensureComponent" },
        { "$ref": "#/$defs/ensureMaterial" },
        { "$ref": "#/$defs/configureCamera" },
        { "$ref": "#/$defs/configureLineRenderer" },
        { "$ref": "#/$defs/saveScene" }
      ]
    },
    "writeScript": {
      "type": "object",
      "required": ["id", "tool", "assetPath", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "WriteCSharpScript" },
        "assetPath": { "type": "string", "pattern": "^Assets/TestOnly/.+\\.cs$" },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ensureScene": {
      "type": "object",
      "required": ["id", "tool", "scenePath"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "EnsureScene" },
        "scenePath": { "type": "string", "pattern": "^Assets/TestOnly/.+\\.unity$" }
      },
      "additionalProperties": false
    },
    "ensureGameObject": {
      "type": "object",
      "required": ["id", "tool", "scenePath", "parentPath", "name", "active"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "EnsureGameObject" },
        "scenePath": { "type": "string" },
        "parentPath": { "type": "string", "pattern": "^/" },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "setTransform": {
      "type": "object",
      "required": ["id", "tool", "scenePath", "targetPath", "position", "rotation", "scale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "SetTransform" },
        "scenePath": { "type": "string" },
        "targetPath": { "type": "string", "pattern": "^/" },
        "position": { "$ref": "#/$defs/vector3" },
        "rotation": { "$ref": "#/$defs/vector3" },
        "scale": { "$ref": "#/$defs/vector3" }
      },
      "additionalProperties": false
    },
    "ensureComponent": {
      "type": "object",
      "required": ["id", "tool", "scenePath", "targetPath", "componentTypeId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "EnsureComponent" },
        "scenePath": { "type": "string" },
        "targetPath": { "type": "string", "pattern": "^/" },
        "componentTypeId": { "enum": ["Camera", "LineRenderer", "HarnessTest"] }
      },
      "additionalProperties": false
    },
    "ensureMaterial": {
      "type": "object",
      "required": ["id", "tool", "assetPath", "shader", "color"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "EnsureMaterial" },
        "assetPath": { "type": "string", "pattern": "^Assets/TestOnly/.+\\.mat$" },
        "shader": { "const": "Sprites/Default" },
        "color": { "$ref": "#/$defs/color" }
      },
      "additionalProperties": false
    },
    "configureCamera": {
      "type": "object",
      "required": ["id", "tool", "scenePath", "targetPath", "tag", "orthographic", "orthographicSize", "backgroundColor"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "ConfigureCamera" },
        "scenePath": { "type": "string" },
        "targetPath": { "type": "string", "pattern": "^/" },
        "tag": { "type": "string", "minLength": 1 },
        "orthographic": { "type": "boolean" },
        "orthographicSize": { "type": "number", "exclusiveMinimum": 0 },
        "backgroundColor": { "$ref": "#/$defs/color" }
      },
      "additionalProperties": false
    },
    "configureLineRenderer": {
      "type": "object",
      "required": ["id", "tool", "scenePath", "targetPath", "materialPath", "useWorldSpace", "loop", "width", "capVertices", "cornerVertices", "sortingOrder", "color", "points"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "ConfigureLineRenderer" },
        "scenePath": { "type": "string" },
        "targetPath": { "type": "string", "pattern": "^/" },
        "materialPath": { "type": "string" },
        "useWorldSpace": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "capVertices": { "type": "integer", "minimum": 0 },
        "cornerVertices": { "type": "integer", "minimum": 0 },
        "sortingOrder": { "type": "integer" },
        "color": { "$ref": "#/$defs/color" },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/vector3" }
        }
      },
      "additionalProperties": false
    },
    "saveScene": {
      "type": "object",
      "required": ["id", "tool", "scenePath"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "const": "SaveScene" },
        "scenePath": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}

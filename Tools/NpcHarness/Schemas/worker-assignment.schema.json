{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NPC Harness WorkerAssignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "assignmentId", "runId", "roleSkill", "policyVersion",
    "objective", "baselineCommit", "baselineDirtyFiles", "requiredContext",
    "writablePaths", "forbiddenPaths", "allowedTools", "forbiddenOperations",
    "artifactPaths", "execution", "acceptanceGate", "acceptanceConditions",
    "preliminaryChecks", "reportRequirements"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "assignmentId": { "$ref": "#/$defs/identifier" },
    "runId": { "$ref": "#/$defs/identifier" },
    "roleSkill": { "$ref": "#/$defs/identifier" },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "objective": { "$ref": "#/$defs/nonWhitespaceString" },
    "baselineCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "baselineDirtyFiles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/repositoryPath" },
      "additionalProperties": { "$ref": "#/$defs/baselineHash" }
    },
    "requiredContext": { "$ref": "#/$defs/nonEmptyUniqueRepositoryPaths" },
    "writablePaths": { "$ref": "#/$defs/nonEmptyUniqueRepositoryPatterns" },
    "forbiddenPaths": { "$ref": "#/$defs/nonEmptyUniqueRepositoryPatterns" },
    "allowedTools": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "forbiddenOperations": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "artifactPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerResultPath", "logPath"],
      "properties": {
        "workerResultPath": { "$ref": "#/$defs/repositoryPath" },
        "logPath": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "execution": {
      "oneOf": [
        { "$ref": "#/$defs/harnessJobExecution" },
        { "$ref": "#/$defs/directCodeExecution" },
        { "$ref": "#/$defs/rasterArtExecution" }
      ]
    },
    "acceptanceGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "profile", "profileVersion"],
      "properties": {
        "manifestPath": { "$ref": "#/$defs/repositoryPath" },
        "profile": { "$ref": "#/$defs/nonWhitespaceString" },
        "profileVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "acceptanceConditions": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "preliminaryChecks": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "reportRequirements": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "nonWhitespaceString": {
      "type": "string",
      "pattern": "\\S"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?=.*\\S)(?!/)(?!.*[\\\\:*?])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "repositoryPattern": {
      "type": "string",
      "pattern": "^(?=.*\\S)(?!/)(?!.*[\\\\:?])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^/*?]+(?:/[^/*?]+)*(?:/\\*\\*)?$"
    },
    "baselineHash": {
      "type": "string",
      "anyOf": [
        { "const": "missing" },
        { "pattern": "^[0-9a-fA-F]{64}$" }
      ]
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonWhitespaceString" }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonWhitespaceString" }
    },
    "uniqueRepositoryPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "nonEmptyUniqueRepositoryPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "nonEmptyUniqueRepositoryPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPattern" }
    },
    "overwriteAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowOverwrite", "approvedValues"],
      "properties": {
        "allowOverwrite": { "type": "boolean" },
        "approvedValues": { "$ref": "#/$defs/uniqueStrings" }
      },
      "allOf": [
        {
          "if": { "properties": { "allowOverwrite": { "const": true } }, "required": ["allowOverwrite"] },
          "then": { "properties": { "approvedValues": { "minItems": 1 } } },
          "else": { "properties": { "approvedValues": { "maxItems": 0 } } }
        }
      ]
    },
    "taskSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hierarchy", "components", "transforms", "serializedValues"],
      "properties": {
        "hierarchy": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "components": { "$ref": "#/$defs/uniqueStrings" },
        "transforms": { "$ref": "#/$defs/uniqueStrings" },
        "serializedValues": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "harnessJobExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "jobId", "jobPath", "adapterResultPath", "allowedComponentTypes",
        "overwriteAuthority", "taskSpecification"
      ],
      "properties": {
        "kind": { "const": "harness-job" },
        "jobId": { "$ref": "#/$defs/identifier" },
        "jobPath": { "$ref": "#/$defs/repositoryPath" },
        "adapterResultPath": { "$ref": "#/$defs/repositoryPath" },
        "allowedComponentTypes": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "overwriteAuthority": { "$ref": "#/$defs/overwriteAuthority" },
        "taskSpecification": { "$ref": "#/$defs/taskSpecification" }
      }
    },
    "directCodeExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourcePaths", "owningDocumentPaths", "compileRequired"],
      "properties": {
        "kind": { "const": "direct-code" },
        "sourcePaths": { "$ref": "#/$defs/nonEmptyUniqueRepositoryPaths" },
        "owningDocumentPaths": { "$ref": "#/$defs/uniqueRepositoryPaths" },
        "compileRequired": { "type": "boolean" }
      }
    },
    "rasterArtExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "assetFamily", "intendedUse", "outputPath", "referenceAssets",
        "importReferenceMetaPath", "importSpecPath", "width", "height", "requireAlpha",
        "frameColumns", "frameRows"
      ],
      "properties": {
        "kind": { "const": "raster-art" },
        "assetFamily": { "$ref": "#/$defs/identifier" },
        "intendedUse": { "$ref": "#/$defs/nonWhitespaceString" },
        "outputPath": { "$ref": "#/$defs/repositoryPath" },
        "referenceAssets": { "$ref": "#/$defs/nonEmptyUniqueRepositoryPaths" },
        "importReferenceMetaPath": { "$ref": "#/$defs/repositoryPath" },
        "importSpecPath": { "$ref": "#/$defs/repositoryPath" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "requireAlpha": { "type": "boolean" },
        "frameColumns": { "type": "integer", "minimum": 1 },
        "frameRows": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
